#--------------------------------------------------------------------------
# MedConnect Saudi - environment template
# Copy to .env and fill in values. NEVER commit .env or real secrets.
# Hosts below point at 127.0.0.1 so artisan works from the host machine;
# compose.yaml overrides them with service names inside containers.
#--------------------------------------------------------------------------

APP_NAME="MedConnect Saudi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated previous APP_KEYs, used to decrypt data during key rotation.
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# All timestamps are stored in UTC; this is the zone used for display / slot generation.
APP_DISPLAY_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--- PostgreSQL -----------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=medconnect
DB_USERNAME=medconnect
DB_PASSWORD=change-me-local-only
DB_SSLMODE=prefer
# Database used by the automated test-suite (created by docker/postgres/init).
DB_TEST_DATABASE=medconnect_test

#--- Sessions / cache / queues (Redis) -----------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=medconnect_cache_

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--- Broadcasting (Laravel Reverb) ---------------------------------------
BROADCAST_CONNECTION=reverb
# Unique per environment. `php scripts/make-env.php .env.example .env` fills these locally.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Host/port the Laravel app uses to publish events to the Reverb server.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Address the Reverb server binds to inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated origins allowed to open WebSocket connections.
REVERB_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

#--- Mail (Mailpit locally) ----------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@medconnect.local"
MAIL_FROM_NAME="${APP_NAME}"

#--- Private object storage ----------------------------------------------
# PRIVATE_FILES_DISK=private  -> local disk at storage/app/private (default)
# PRIVATE_FILES_DISK=s3       -> S3-compatible bucket (emulator: `--profile storage`)
FILESYSTEM_DISK=local
PRIVATE_FILES_DISK=private
AWS_ACCESS_KEY_ID=medconnect
AWS_SECRET_ACCESS_KEY=change-me-local-only
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=medconnect-private
AWS_ENDPOINT=http://127.0.0.1:9090
AWS_USE_PATH_STYLE_ENDPOINT=true

#--- Security --------------------------------------------------------------
# Comma-separated list of SPA origins (Vue) allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Personal access token lifetime in minutes (mobile + SPA bearer tokens).
SANCTUM_TOKEN_EXPIRATION=43200
# Short-lived token issued after password login, before MFA is completed (minutes).
MFA_CHALLENGE_TTL=10
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Pepper mixed into OTP / lookup hashes. Must differ per environment.
OTP_HASH_KEY=

#--- External integrations (mock adapters until approved) ----------------
# Each integration stays on "mock" until a contract, credentials and regulatory
# approval exist. See docs/compliance/requirements-register.md.
SMS_DRIVER=log
PUSH_DRIVER=log
VIDEO_DRIVER=mock
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=
PRESCRIPTION_GATEWAY=mock
CLINICAL_SAFETY_CHECKER=mock
# Lets simulated (mock-issued) prescriptions reach pharmacies locally. Never honoured in production.
ALLOW_SIMULATED_DISPENSING=true
PHARMACY_GATEWAY=mock
PROFESSIONAL_VERIFICATION_DRIVER=manual
FILE_SCANNER_DRIVER=mock
# Payout execution is disabled until provider capabilities + regulatory review are confirmed.
PAYOUTS_ENABLED=false

#--- Docker port forwarding (host side) ----------------------------------
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=8025
FORWARD_S3_PORT=9090

VITE_APP_NAME="${APP_NAME}"
