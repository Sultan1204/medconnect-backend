 * Handles a record.
 *
 * All records may be passed to this method, and the handler should discard
 * those that it does not want to handle.
 *
 * The return value of this function controls the bubbling process of the handler stack.
 * Unless the bubbling is interrupted (by returning true), the Logger class will keep on
 * calling further handlers in the stack with a given log record.
 *
 * @param  LogRecord $record The record to handle
 * @return bool      true means that this handler handled the record, and that bubbling is not permitted.
 *                   false means the record was either not processed or that this handler allows bubbling.
 */";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:5;s:9:"endColumn";i:52;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:15:"Monolog\Handler";s:18:"declaringClassName";s:32:"Monolog\Handler\HandlerInterface";s:21:"implementingClassName";s:32:"Monolog\Handler\HandlerInterface";s:16:"currentClassName";s:32:"Monolog\Handler\HandlerInterface";s:9:"aliasName";N;}s:11:"handleBatch";a:20:{s:4:"name";s:11:"handleBatch";s:10:"parameters";a:1:{s:7:"records";a:13:{s:4:"name";s:7:"records";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:57;s:7:"endLine";i:57;s:11:"startColumn";i:33;s:9:"endColumn";i:46;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:105:"/**
